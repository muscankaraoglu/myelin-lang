{
  "Function Declaration (#fn)": {
    "prefix": "#fn",
    "body": [
      "#fn ${1:name} [${2:arg}:${3:type} -> ${4:i64!TxErr}] ${5:!io}",
      "  req ${6:arg > 0}",
      "  ens ${7:ret >= 0}",
      "  ${0:= 0}"
    ],
    "description": "Declare a top-level Myelin function with contracts and capabilities"
  },
  "Record Declaration (#rec)": {
    "prefix": "#rec",
    "body": [
      "#rec ${1:Name} [${2:id}:${3:u64} ${4:active}:${5:bool} ${6:val}:${7:i64}]"
    ],
    "description": "Declare a Myelin struct record"
  },
  "Sum Type Declaration (#sum)": {
    "prefix": "#sum",
    "body": [
      "#sum ${1:Name} [${2:VariantA} ${3:VariantB}(${4:i64}) ${5:Error(str)}]"
    ],
    "description": "Declare a Myelin tagged union sum type"
  },
  "Conditional Branch (@if)": {
    "prefix": "@if",
    "body": [
      "@if ${1:cond}",
      "  ${2:-- true branch}",
      "@elif ${3:other_cond}",
      "  ${4:-- elif branch}",
      "@el",
      "  ${0:-- fallback}"
    ],
    "description": "Branching conditional statement (@if / @elif / @el)"
  },
  "Loop Statement (@loop)": {
    "prefix": "@loop",
    "body": [
      "@loop",
      "  ? ${1:idx < 10} | @brk",
      "  ${0:idx = idx + 1}"
    ],
    "description": "Loop with exit condition (@loop / @brk)"
  },
  "For Loop (@for)": {
    "prefix": "@for",
    "body": [
      "@for ${1:item} : ${2:collection}",
      "  ? ${3:item.active} | @next",
      "  ${0:-- process item}"
    ],
    "description": "Iterate over collection or slice"
  },
  "Pattern Match (@match)": {
    "prefix": "@match",
    "body": [
      "@match ${1:expr}",
      "  Ok(${2:v})  => = ${2:v}",
      "  Err(${3:e}) => ^ ${3:e}",
      "  _      => ${0:= -1}"
    ],
    "description": "Exhaustive pattern match block"
  },
  "Contracts (req/ens)": {
    "prefix": "contract",
    "body": [
      "req ${1:amt > 0}",
      "ens ${2:ret >= 0}"
    ],
    "description": "Insert precondition and postcondition verification contracts"
  },
  "Guard with Early Return": {
    "prefix": "guard",
    "body": [
      "? ${1:condition} | ^${2:ErrVariant}"
    ],
    "description": "Guard condition with early error return"
  },
  "Unit Test Declaration (#test)": {
    "prefix": "#test",
    "body": [
      "#test ${1:test_name}",
      "  res = ${2:call}",
      "  ? ${0:res == expected}"
    ],
    "description": "Declare an embedded Myelin unit test"
  },
  "Module Declaration (#mod)": {
    "prefix": "#mod",
    "body": [
      "#mod ${1:std.math}"
    ],
    "description": "Declare module namespace"
  },
  "Module Import (#use)": {
    "prefix": "#use",
    "body": [
      "#use ${1:std.io}"
    ],
    "description": "Import external or stdlib module"
  },
  "CLI Application (cli-app)": {
    "prefix": "cli-app",
    "body": [
      "#mod ${1:main}",
      "",
      "#fn main [] !io !cli !term",
      "  banner = term.bold (term.cyan \"=== ${2:CLI App} ===\")",
      "  io.println banner",
      "  ",
      "  args = cli.args",
      "  arg_count = args.len",
      "  io.println (term.bold (str.fmt \"-> Arguments count: {}\" arg_count))",
      "  ",
      "  release = cli.flag_bool \"--release\"",
      "  target = cli.flag_str \"--target\" \"${3:native}\"",
      "  workers = cli.flag_int \"--jobs\" ${4:4}",
      "  ",
      "  @if release",
      "    io.println (term.green \"  • Profile: RELEASE (LTO active)\")",
      "  @el",
      "    io.println (term.yellow \"  • Profile: DEV (safety checks active)\")",
      "  ",
      "  io.println (term.cyan (str.fmt \"  • Target: {}, Workers: {}\" target workers))",
      "  io.println (term.green \"✔ Done.\")",
      "  ${0:= 0}"
    ],
    "description": "Quick template for a command-line tool with flags and term banners"
  },
  "Web API Microservice (web-api)": {
    "prefix": "web-api",
    "body": [
      "#mod ${1:main}",
      "",
      "#fn ${2:handle_request} [path:str -> str]",
      "  @if path == \"/\"",
      "    = \"${3:Welcome to Myelin Web API!}\"",
      "  @elif path == \"/health\"",
      "    = \"{\\\"status\\\": \\\"healthy\\\"}\"",
      "  @el",
      "    = str.fmt \"404 Not Found: Path '{}' is not registered\" path",
      "",
      "#fn main [] !net !io",
      "  io.println (str.fmt \"Starting Myelin HTTP Server on port {}...\" ${4:8080})",
      "  ${0:_ = http.serve ${4:8080} \"${2:handle_request}\"}"
    ],
    "description": "Quick template for an HTTP microservice with http.serve"
  },
  "Embedded DB CRUD (db-crud)": {
    "prefix": "db-crud",
    "body": [
      "#mod ${1:main}",
      "",
      "#fn main [] !db !io",
      "  io.println \"Connecting to embedded key-value store...\"",
      "  ",
      "  -- Insert / Update record",
      "  _ = db.set \"${2:key:1}\" \"${3:value}\"",
      "  ",
      "  -- Verify existence and query record",
      "  exists = db.has \"${2:key:1}\"",
      "  @if exists",
      "    val = db.get \"${2:key:1}\"",
      "    io.println (str.fmt \"Record [{}]: {}\" \"${2:key:1}\" val)",
      "  @el",
      "    io.println (str.fmt \"Record [{}] not found\" \"${2:key:1}\")",
      "  ",
      "  ${0:= 0}"
    ],
    "description": "Quick template for embedded storage with db.set and db.get"
  }
}
