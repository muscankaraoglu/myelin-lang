{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Myelin",
  "scopeName": "source.myelin",
  "fileTypes": ["myl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#top-level" },
    { "include": "#control-tags" },
    { "include": "#contracts" },
    { "include": "#capabilities" },
    { "include": "#types" },
    { "include": "#guard-returns" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#builtins" },
    { "include": "#field-binding" },
    { "include": "#function-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-dash.myelin",
      "match": "--.*$"
    },
    "strings": {
      "name": "string.quoted.double.myelin",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.myelin",
          "match": "\\\\."
        }
      ]
    },
    "top-level": {
      "patterns": [
        {
          "match": "^(#mod)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.directive.mod.myelin" },
            "2": { "name": "entity.name.namespace.myelin" }
          }
        },
        {
          "match": "^(#use)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.directive.use.myelin" },
            "2": { "name": "entity.name.namespace.myelin" }
          }
        },
        {
          "match": "^(#fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.fn.myelin" },
            "2": { "name": "entity.name.function.myelin" }
          }
        },
        {
          "match": "^(#rec)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.rec.myelin" },
            "2": { "name": "entity.name.type.struct.myelin" }
          }
        },
        {
          "match": "^(#sum)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.sum.myelin" },
            "2": { "name": "entity.name.type.enum.myelin" }
          }
        },
        {
          "match": "^(#ext)\\s+(\"[^\"]*\")\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.ext.myelin" },
            "2": { "name": "string.quoted.double.abi.myelin" },
            "3": { "name": "entity.name.function.external.myelin" }
          }
        },
        {
          "match": "^(#test)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.test.myelin" },
            "2": { "name": "entity.name.function.test.myelin" }
          }
        },
        {
          "name": "keyword.control.directive.myelin",
          "match": "^#(mod|use|rec|sum|ext|fn|test)\\b"
        }
      ]
    },
    "control-tags": {
      "patterns": [
        {
          "name": "keyword.control.conditional.myelin",
          "match": "@(if|elif|el)\\b"
        },
        {
          "name": "keyword.control.loop.myelin",
          "match": "@(for|loop)\\b"
        },
        {
          "name": "keyword.control.flow.jump.myelin",
          "match": "@(next|brk)\\b"
        },
        {
          "name": "keyword.control.match.myelin",
          "match": "@match\\b"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "keyword.control.contract.req.myelin",
          "match": "\\breq\\b"
        },
        {
          "name": "keyword.control.contract.ens.myelin",
          "match": "\\bens\\b"
        },
        {
          "name": "variable.language.ret.myelin",
          "match": "\\bret\\b"
        }
      ]
    },
    "capabilities": {
      "patterns": [
        {
          "name": "invalid.illegal.unsafe.myelin",
          "match": "(?<=[\\s\\]])!unsafe(?:\\.[a-zA-Z0-9_]+)?\\b"
        },
        {
          "name": "keyword.control.capability.security.myelin entity.name.tag.capability.security.myelin",
          "match": "(?<=[\\s\\]])!(?:net|db|fs|proc|env|cloud)(?:\\.[a-zA-Z0-9_]+)?\\b"
        },
        {
          "name": "entity.name.tag.capability.cli.myelin entity.name.tag.capability.myelin",
          "match": "(?<=[\\s\\]])!(?:term|cli)(?:\\.[a-zA-Z0-9_]+)?\\b"
        },
        {
          "name": "entity.name.tag.capability.host.myelin entity.name.tag.capability.myelin",
          "match": "(?<=[\\s\\]])!(?:io|time|rand|hw)(?:\\.[a-zA-Z0-9_]+)?\\b"
        },
        {
          "name": "entity.name.tag.capability.ai.myelin entity.name.tag.capability.myelin",
          "match": "(?<=[\\s\\]])!(?:ai)(?:\\.[a-zA-Z0-9_]+)?\\b"
        },
        {
          "name": "entity.name.tag.capability.gui.myelin entity.name.tag.capability.myelin",
          "match": "(?<=[\\s\\]])!(?:gui|mobile)(?:\\.[a-zA-Z0-9_]+)?\\b"
        },
        {
          "name": "entity.name.tag.capability.general.myelin entity.name.tag.capability.myelin",
          "match": "(?<=[\\s\\]])![a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z0-9_]+)?\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "(\\?)((?:i8|i16|i32|i64|u8|u16|u32|u64|usz|f32|f64|bool|str|bytes|[A-Z][a-zA-Z0-9_]*|\\[\\][a-zA-Z0-9_]+))(!)([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.optional.myelin" },
            "2": { "name": "support.type.myelin" },
            "3": { "name": "storage.modifier.fallible.myelin" },
            "4": { "name": "entity.name.type.error.myelin" }
          }
        },
        {
          "match": "((?:i8|i16|i32|i64|u8|u16|u32|u64|usz|f32|f64|bool|str|bytes|[A-Z][a-zA-Z0-9_]*|\\[\\][a-zA-Z0-9_]+))(!)([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "support.type.myelin" },
            "2": { "name": "storage.modifier.fallible.myelin" },
            "3": { "name": "entity.name.type.error.myelin" }
          }
        },
        {
          "match": "(\\?)((?:i8|i16|i32|i64|u8|u16|u32|u64|usz|f32|f64|bool|str|bytes|[A-Z][a-zA-Z0-9_]*|\\[\\][a-zA-Z0-9_]+|\\[[^\\]]+\\]))",
          "captures": {
            "1": { "name": "storage.modifier.optional.myelin" },
            "2": { "name": "support.type.myelin" }
          }
        },
        {
          "match": "(\\[\\])([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.array.myelin" },
            "2": { "name": "support.type.myelin" }
          }
        },
        {
          "match": "(\\*)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.pointer.myelin" },
            "2": { "name": "support.type.myelin" }
          }
        },
        {
          "name": "support.type.primitive.integer.myelin",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|usz)\\b"
        },
        {
          "name": "support.type.primitive.float.myelin",
          "match": "\\b(f32|f64)\\b"
        },
        {
          "name": "support.type.primitive.other.myelin",
          "match": "\\b(bool|str|bytes)\\b"
        },
        {
          "name": "entity.name.type.constructor.myelin",
          "match": "\\b(Ok|Err|Some)\\b"
        },
        {
          "name": "entity.name.type.user-defined.myelin",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "guard-returns": {
      "patterns": [
        {
          "name": "keyword.operator.early-return-error.myelin",
          "match": "\\^"
        },
        {
          "name": "keyword.operator.guard-pipe.myelin",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.guard-assert.myelin",
          "match": "(?:^|\\s)\\?(?=\\s)"
        },
        {
          "name": "keyword.operator.error-unwrap-propagate.myelin",
          "match": "(?<=\\S)\\?(?=\\s|$)"
        },
        {
          "name": "keyword.operator.normal-return.myelin",
          "match": "(?:^\\s*)=\\s"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.myelin",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.none.myelin",
          "match": "\\bnone\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.myelin",
          "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.myelin",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.myelin",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.fat.myelin", "match": "=>" },
        { "name": "keyword.operator.arrow.thin.myelin", "match": "->" },
        { "name": "keyword.operator.coalescing.myelin", "match": "\\?\\?" },
        { "name": "keyword.operator.comparison.myelin", "match": "(==|!=|<=|>=|<|>)" },
        { "name": "keyword.operator.logical.myelin", "match": "(&&|\\|\\||!)" },
        { "name": "keyword.operator.arithmetic.myelin", "match": "[\\+\\-\\*/%]" },
        { "name": "keyword.operator.assignment.myelin", "match": "=" }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "match": "\\b(term)\\.(green|red|cyan|bold|yellow|blue|magenta|gray|dim|reset)\\b",
          "captures": {
            "1": { "name": "support.class.builtin.term.myelin support.class.builtin.myelin" },
            "2": { "name": "support.function.builtin.term.myelin support.function.builtin.myelin" }
          }
        },
        {
          "match": "\\b(cli)\\.(args|count|arg_count|flag_bool|has_flag|flag_str|flag_int)\\b",
          "captures": {
            "1": { "name": "support.class.builtin.cli.myelin support.class.builtin.myelin" },
            "2": { "name": "support.function.builtin.cli.myelin support.function.builtin.myelin" }
          }
        },
        {
          "match": "\\b(io)\\.(println|print|read_line|read_all)\\b",
          "captures": {
            "1": { "name": "support.class.builtin.io.myelin support.class.builtin.myelin" },
            "2": { "name": "support.function.builtin.io.myelin support.function.builtin.myelin" }
          }
        },
        {
          "match": "\\b(str)\\.(fmt|len|split|join|trim|to_upper|to_lower|starts_with|ends_with|contains)\\b",
          "captures": {
            "1": { "name": "support.class.builtin.str.myelin support.class.builtin.myelin" },
            "2": { "name": "support.function.builtin.str.myelin support.function.builtin.myelin" }
          }
        },
        {
          "match": "\\b(db)\\.(set|get|has|del)\\b",
          "captures": {
            "1": { "name": "support.class.builtin.db.myelin support.class.builtin.myelin" },
            "2": { "name": "support.function.builtin.db.myelin support.function.builtin.myelin" }
          }
        },
        {
          "match": "\\b(http)\\.(serve|get|post|request)\\b",
          "captures": {
            "1": { "name": "support.class.builtin.http.myelin support.class.builtin.myelin" },
            "2": { "name": "support.function.builtin.http.myelin support.function.builtin.myelin" }
          }
        },
        {
          "match": "\\b(io|str|db|http|term|cli|ai|gui|mobile|hw|cloud)\\.([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "support.class.builtin.myelin" },
            "2": { "name": "support.function.builtin.myelin" }
          }
        },
        {
          "name": "support.class.builtin.myelin",
          "match": "\\b(io|str|db|http|term|cli|ai|gui|mobile|hw|cloud)\\b"
        }
      ]
    },
    "field-binding": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
      "captures": {
        "1": { "name": "variable.parameter.myelin" },
        "2": { "name": "punctuation.separator.colon.myelin" }
      }
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\.([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "variable.other.module.or.receiver.myelin" },
        "2": { "name": "entity.name.function.call.myelin" }
      }
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.language.discard.myelin",
          "match": "\\b_\\b"
        },
        {
          "name": "variable.other.myelin",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
